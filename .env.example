MAIL_WEB_VERSION=0.1.0-dev
LISTEN_ADDRESS=127.0.0.1
PORT=18090
# Set to the exact HTTPS origin of your own reverse proxy; no trailing slash.
PUBLIC_ORIGIN=https://mail-web.example.com
STALWART_URL=https://mail.iqwq.com
STALWART_NETWORK=stalwart1_mail
STALWART_DOMAIN_ID=
STALWART_HOOK_ID=
NOTIFICATION_ACCOUNT_ID=
NOTIFICATION_EMAIL=no-reply@iqwq.com
TURNSTILE_SITE_KEY=
# Remains false until SMTP and JMAP hook enforcement has passed acceptance.
MTA_POLICY_VERIFIED=false
RUST_LOG=mail_web=info,tower_http=warn
# Exact proxy IPs only. Trusted proxies must overwrite X-Real-IP themselves.
TRUSTED_PROXY_IPS=
