# Infrastructure only. Configure the site and Stalwart in /setup/ after startup.
MAIL_WEB_VERSION=0.2.0-alpha.1
CONTAINER_NAME=mail-web
LISTEN_ADDRESS=127.0.0.1
PORT=18090
ALLOW_HTTP=false
RELEASE_REPOSITORY=reina0721/mail-web
RUST_LOG=mail_web=info,tower_http=warn
# Optional legacy values; normally leave these empty and use the setup panel.
PUBLIC_ORIGIN=
STALWART_URL=
MAIL_DOMAIN=
SITE_NAME=Mail Web
TRUSTED_PROXY_IPS=
